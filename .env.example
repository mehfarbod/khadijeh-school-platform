# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# NextAuth
# Generate a long random value for production.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# One-time fresh-install bootstrap values. Set them only for the bootstrap
# command and remove them from the execution environment immediately after use.
# BOOTSTRAP_ADMIN_NATIONAL_ID=
# BOOTSTRAP_ADMIN_MOBILE=
# BOOTSTRAP_ADMIN_FIRST_NAME=
# BOOTSTRAP_ADMIN_LAST_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# SMS recovery is fail-closed until an approved provider is implemented in
# src/lib/notifications/sms.ts. Do not add placeholder production credentials.
# For local development only, explicitly opt in to masked OTP diagnostics:
# DEV_EXPOSE_AUTH_OTP=false
